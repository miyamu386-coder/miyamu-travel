import UIKit
import MapKit
import CoreLocation
import ImageIO

final class TravelMofuMapViewController: UIViewController, CLLocationManagerDelegate, MKMapViewDelegate {

    private let mapView = MKMapView()
    private let locationManager = CLLocationManager()

    private let travelMode: String
    private var frameDurations: [Double] = []
    private var animationStart = Date()

    private let destinationName: String
    private let destinationCoordinate: CLLocationCoordinate2D

    private let mofu = MKPointAnnotation()
    private let destination = MKPointAnnotation()

    private var routeOverlay: MKPolyline?
    private var directions: MKDirections?
    private var mofuView: MKAnnotationView?
    private var mofuFrames: [UIImage] = []
    private var lastMovementTime = Date.distantPast
    private var movementTimer: Timer?
    private var lastCoordinate: CLLocationCoordinate2D?
    private var speechLabel: UILabel?
    private var speechHideWork: DispatchWorkItem?


    init(
        name: String,
        coordinate: CLLocationCoordinate2D,
        mode: String = "walking"
    ) {
        self.travelMode = ["walking", "driving", "transit"].contains(mode)
            ? mode : "walking"
        self.destinationName = name
        self.destinationCoordinate = coordinate
        super.init(nibName: nil, bundle: nil)
        modalPresentationStyle = .fullScreen
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func viewDidLoad() {
        super.viewDidLoad()

        view.backgroundColor = .systemBackground

        mapView.frame = view.bounds
        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
        mapView.delegate = self
        mapView.showsUserLocation = false
        view.addSubview(mapView)

        destination.coordinate = destinationCoordinate
        destination.title = destinationName
        mapView.addAnnotation(destination)

        loadMofuFrames()
        setupMofuSpeech()
        showMofuSpeech("さぁ、出発するぞ！")


        mofu.title = "モフ"
        mapView.addAnnotation(mofu)

        let close = UIButton(type: .system)
        close.setTitle("✕ 旅を終了", for: .normal)
        close.backgroundColor = .systemBackground
        close.layer.cornerRadius = 14
        close.translatesAutoresizingMaskIntoConstraints = false
        close.addTarget(self, action: #selector(closeMap), for: .touchUpInside)
        view.addSubview(close)

        NSLayoutConstraint.activate([
            close.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 12),
            close.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 16),
            close.widthAnchor.constraint(equalToConstant: 130),
            close.heightAnchor.constraint(equalToConstant: 48)
        ])

        movementTimer = Timer.scheduledTimer(
            timeInterval: 0.5,
            target: self,
            selector: #selector(updateMofuAnimation),
            userInfo: nil,
            repeats: true
        )

        locationManager.delegate = self
        locationManager.desiredAccuracy = kCLLocationAccuracyBest
        locationManager.distanceFilter = 5

        switch locationManager.authorizationStatus {
        case .notDetermined:
            locationManager.requestWhenInUseAuthorization()
        case .authorizedAlways, .authorizedWhenInUse:
            locationManager.startUpdatingLocation()
        default:
            break
        }

        let region = MKCoordinateRegion(
            center: destinationCoordinate,
            latitudinalMeters: 1200,
            longitudinalMeters: 1200
        )
        mapView.setRegion(region, animated: false)
    }





    private func setupMofuSpeech() {
        let label = UILabel()
        label.numberOfLines = 2
        label.textAlignment = .center
        label.font = .boldSystemFont(ofSize: 15)
        label.textColor = .label
        label.backgroundColor = .secondarySystemBackground
        label.layer.cornerRadius = 16
        label.layer.masksToBounds = true
        label.translatesAutoresizingMaskIntoConstraints = false
        label.isHidden = true

        view.addSubview(label)

        NSLayoutConstraint.activate([
            label.centerXAnchor.constraint(equalTo: view.centerXAnchor),
            label.bottomAnchor.constraint(
                equalTo: view.safeAreaLayoutGuide.bottomAnchor,
                constant: -30
            ),
            label.widthAnchor.constraint(
                lessThanOrEqualTo: view.widthAnchor,
                constant: -32
            ),
            label.widthAnchor.constraint(
                greaterThanOrEqualToConstant: 170
            ),
            label.heightAnchor.constraint(
                greaterThanOrEqualToConstant: 52
            )
        ])

        speechLabel = label
    }

    private func showMofuSpeech(_ message: String) {
        speechHideWork?.cancel()

        speechLabel?.text = "🐾 モフ「\(message)」"
        speechLabel?.isHidden = false

        let work = DispatchWorkItem { [weak self] in
            self?.speechLabel?.isHidden = true
        }

        speechHideWork = work
        DispatchQueue.main.asyncAfter(
            deadline: .now() + 8,
            execute: work
        )
    }

    @objc private func closeMap() {
        locationManager.stopUpdatingLocation()
        movementTimer?.invalidate()
        movementTimer = nil
        mofuView?.image = mofuFrames.first
        directions?.cancel()
        dismiss(animated: true)
    }

    func locationManagerDidChangeAuthorization(_ manager: CLLocationManager) {
        if manager.authorizationStatus == .authorizedAlways ||
           manager.authorizationStatus == .authorizedWhenInUse {
            manager.startUpdatingLocation()
        }
    }

    func locationManager(_ manager: CLLocationManager, didUpdateLocations locations: [CLLocation]) {
        guard let location = locations.last,
              location.horizontalAccuracy >= 0 else { return }

        if let previous = lastCoordinate {
            let oldLocation = CLLocation(
                latitude: previous.latitude,
                longitude: previous.longitude
            )
            let moved = location.distance(from: oldLocation)

            if moved >= 3 && location.horizontalAccuracy <= 35 {
                lastMovementTime = Date()
            }
        }

        lastCoordinate = location.coordinate
        mofu.coordinate = location.coordinate

        if routeOverlay == nil && directions == nil {
            calculateRoute(from: location.coordinate)
        }
    }

    private func calculateRoute(from coordinate: CLLocationCoordinate2D) {
        let request = MKDirections.Request()
        request.source = MKMapItem(
            placemark: MKPlacemark(coordinate: coordinate)
        )
        request.destination = MKMapItem(
            placemark: MKPlacemark(coordinate: destinationCoordinate)
        )
        switch travelMode {
        case "driving":
            request.transportType = .automobile
        case "transit":
            request.transportType = .transit
        default:
            request.transportType = .walking
        }

        let directions = MKDirections(request: request)
        self.directions = directions

        directions.calculate { [weak self] response, _ in
            guard let self else { return }
            self.directions = nil

            guard let route = response?.routes.first else { return }

            self.routeOverlay = route.polyline
            self.mapView.addOverlay(route.polyline)
            self.mapView.setVisibleMapRect(
                route.polyline.boundingMapRect,
                edgePadding: UIEdgeInsets(top: 100, left: 40, bottom: 80, right: 40),
                animated: true
            )
        }
    }

    func mapView(_ mapView: MKMapView, viewFor annotation: MKAnnotation) -> MKAnnotationView? {
        if annotation === destination {
            return nil
        }

        if annotation === mofu {
            let identifier = "Mofu"
            let view = mapView.dequeueReusableAnnotationView(withIdentifier: identifier)
                ?? MKAnnotationView(annotation: annotation, reuseIdentifier: identifier)

            view.annotation = annotation
            view.canShowCallout = true

            view.image = mofuFrames.first
            mofuView = view
            return view
        }

        return nil
    }

    private func loadMofuFrames() {
        mofuFrames.removeAll()
        frameDurations.removeAll()

        if travelMode == "walking" {
            guard let url = Bundle.main.url(
                forResource: "mofu-travel-walk",
                withExtension: "png"
            ),
            let image = UIImage(contentsOfFile: url.path),
            let cgImage = image.cgImage else {
                NSLog("⚠️ 徒歩モフを読み込めません")
                return
            }

            let width = cgImage.width / 2
            let height = cgImage.height / 2

            let rectangles = [
                CGRect(x: 0, y: 0, width: width, height: height),
                CGRect(x: width, y: 0, width: width, height: height)
            ]

            mofuFrames = rectangles.compactMap { rect in
                guard let cropped = cgImage.cropping(to: rect) else {
                    return nil
                }

                return UIImage(cgImage: cropped)
                    .resized(to: CGSize(width: 80, height: 80))
            }

            frameDurations = Array(
                repeating: 0.5,
                count: mofuFrames.count
            )
            return
        }

        let fileName = travelMode == "driving"
            ? "mofu-car" : "mofu-train"

        guard let url = Bundle.main.url(
            forResource: fileName,
            withExtension: "gif"
        ),
        let source = CGImageSourceCreateWithURL(
            url as CFURL, nil
        ) else {
            NSLog("⚠️ GIFを読み込めません: %@", fileName)
            return
        }

        let frameCount = CGImageSourceGetCount(source)

        for index in 0..<frameCount {
            guard let cgImage = CGImageSourceCreateImageAtIndex(
                source, index, nil
            ) else {
                continue
            }

            let image = UIImage(cgImage: cgImage)
                .resized(to: CGSize(width: 100, height: 70))

            mofuFrames.append(image)

            let properties = CGImageSourceCopyPropertiesAtIndex(
                source, index, nil
            ) as? [String: Any]

            let gifProperties = properties?[
                kCGImagePropertyGIFDictionary as String
            ] as? [String: Any]

            let delay = (
                gifProperties?[
                    kCGImagePropertyGIFUnclampedDelayTime as String
                ] as? NSNumber
                ?? gifProperties?[
                    kCGImagePropertyGIFDelayTime as String
                ] as? NSNumber
            )?.doubleValue ?? 0.15

            frameDurations.append(max(0.05, delay))
        }

        NSLog(
            "🐈 %@: %dコマ読み込み",
            fileName,
            mofuFrames.count
        )
    }

    @objc private func updateMofuAnimation() {
        guard !mofuFrames.isEmpty else { return }

        let isMoving = Date().timeIntervalSince(
            lastMovementTime
        ) < 3

        guard isMoving else {
            animationStart = Date()
            mofuView?.image = mofuFrames[0]
            return
        }

        let totalDuration = frameDurations.reduce(0, +)

        guard totalDuration > 0 else { return }

        var elapsed = Date().timeIntervalSince(
            animationStart
        ).truncatingRemainder(
            dividingBy: totalDuration
        )

        for (index, duration) in frameDurations.enumerated() {
            if elapsed < duration {
                mofuView?.image = mofuFrames[index]
                return
            }
            elapsed -= duration
        }

        mofuView?.image = mofuFrames[0]
    }







func mapView(_ mapView: MKMapView, rendererFor overlay: MKOverlay) -> MKOverlayRenderer {
        let renderer = MKPolylineRenderer(overlay: overlay)
        renderer.strokeColor = .systemGreen
        renderer.lineWidth = 6
        return renderer
    }
}

private extension UIImage {
    func resized(to size: CGSize) -> UIImage {
        let renderer = UIGraphicsImageRenderer(size: size)
        return renderer.image { _ in
            draw(in: CGRect(origin: .zero, size: size))
        }
    }
}
